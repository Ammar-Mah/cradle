{
	"$schema": "https://schemas.wp.org/wp/7.1/block.json",
	"apiVersion": 3,
	"name": "cradle-forms/field-file",
	"version": "1.0.0",
	"title": "File upload field",
	"category": "cradle-forms",
	"icon": "paperclip",
	"description": "Files stored privately and downloadable only by entry viewers.",
	"keywords": [
		"form",
		"field",
		"file"
	],
	"textdomain": "cradle-forms",
	"attributes": {
		"name": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"help": {
			"type": "string",
			"default": ""
		},
		"required": {
			"type": "boolean",
			"default": false
		},
		"width": {
			"type": "string",
			"enum": [
				"full",
				"half"
			],
			"default": "full"
		},
		"accept": {
			"type": "string",
			"default": "pdf"
		},
		"maxSize": {
			"type": "number",
			"default": 5
		},
		"maxFiles": {
			"type": "integer",
			"default": 1
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"className": false,
		"customClassName": false
	},
	"editorScript": "cradle-forms-fields",
	"editorStyle": "cradle-forms-editor"
}
