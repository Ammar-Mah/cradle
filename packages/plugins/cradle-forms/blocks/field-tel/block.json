{
	"$schema": "https://schemas.wp.org/wp/7.1/block.json",
	"apiVersion": 3,
	"name": "cradle-forms/field-tel",
	"version": "1.0.0",
	"title": "Phone field",
	"category": "cradle-forms",
	"icon": "phone",
	"description": "A phone number.",
	"keywords": [
		"form",
		"field",
		"tel"
	],
	"textdomain": "cradle-forms",
	"attributes": {
		"name": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"help": {
			"type": "string",
			"default": ""
		},
		"placeholder": {
			"type": "string",
			"default": ""
		},
		"required": {
			"type": "boolean",
			"default": false
		},
		"width": {
			"type": "string",
			"enum": [
				"full",
				"half"
			],
			"default": "full"
		},
		"defaultValue": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"className": false,
		"customClassName": false
	},
	"editorScript": "cradle-forms-fields",
	"editorStyle": "cradle-forms-editor"
}
