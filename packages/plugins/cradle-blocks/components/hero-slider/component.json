{
	"schemaVersion": 1,
	"id": "cradle/hero-slider",
	"version": "3.0.0",
	"owner": "cradle-blocks",
	"title": "Hero slider",
	"description": "An accessible hero slideshow whose slides are published entries (featured image, title, excerpt and a link). Every style and behavior option is set on the block instance.",
	"category": "media",
	"properties": {
		"postType": { "type": "string", "format": "slug", "default": "post", "maxLength": 20 },
		"taxonomy": { "type": "string", "format": "slug", "default": "", "maxLength": 32 },
		"term": { "type": "string", "format": "slug", "default": "", "maxLength": 200 },
		"postIds": { "type": "array", "items": { "type": "integer", "format": "post", "minimum": 0 }, "maxItems": 12, "default": [] },
		"count": { "type": "integer", "minimum": 1, "maximum": 12, "default": 3 },
		"orderBy": { "type": "string", "enum": [ "date", "title", "menu_order", "modified" ], "default": "date" },
		"order": { "type": "string", "enum": [ "desc", "asc" ], "default": "desc" },
		"showExcerpt": { "type": "boolean", "default": true },
		"showButton": { "type": "boolean", "default": true },
		"buttonText": { "type": "string", "default": "", "maxLength": 40 },
		"headingLevel": { "type": "integer", "minimum": 1, "maximum": 4, "default": 2 },
		"label": { "type": "string", "default": "", "maxLength": 120 },
		"minHeight": { "type": "string", "default": "70vh", "maxLength": 16 },
		"mobileMinHeight": { "type": "string", "default": "60svh", "maxLength": 16 },
		"textPlacement": { "type": "string", "enum": [ "top", "center", "bottom" ], "default": "center" },
		"contentAlign": { "type": "string", "enum": [ "start", "center", "end" ], "default": "center" },
		"contentWidth": { "type": "string", "enum": [ "narrow", "medium", "wide" ], "default": "medium" },
		"focalX": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
		"focalY": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
		"overlayColor": { "type": "string", "default": "contrast", "maxLength": 60 },
		"overlayOpacity": { "type": "integer", "minimum": 0, "maximum": 90, "default": 40 },
		"textColor": { "type": "string", "default": "base", "maxLength": 60 },
		"backgroundColor": { "type": "string", "default": "contrast", "maxLength": 60 },
		"controlsColor": { "type": "string", "default": "base", "maxLength": 60 },
		"transition": { "type": "string", "enum": [ "none", "fade", "slide" ], "default": "fade" },
		"duration": { "type": "integer", "minimum": 0, "maximum": 1200, "default": 500 },
		"autoplay": { "type": "boolean", "default": false },
		"interval": { "type": "integer", "minimum": 3000, "maximum": 20000, "default": 7000 },
		"pauseOnHover": { "type": "boolean", "default": true },
		"arrows": { "type": "boolean", "default": true },
		"indicators": { "type": "boolean", "default": true },
		"loop": { "type": "boolean", "default": true },
		"swipe": { "type": "boolean", "default": true }
	},
	"slots": [],
	"adapters": {
		"gutenberg": { "blockName": "cradle/hero-slider" },
		"shortcode": true
	},
	"assets": {
		"styleHandles": [ "cradle-hero-slider-style" ],
		"viewScriptHandles": [ "cradle-hero-slider-view" ]
	},
	"renderContract": "hero-slider-v2",
	"themeOverride": "cradle/components/hero-slider/render.php",
	"fallbackPolicy": "none",
	"cache": "public"
}
