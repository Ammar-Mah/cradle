{
	"$schema": "https://schemas.wp.org/wp/7.1/block.json",
	"apiVersion": 3,
	"name": "cradle/feature-card",
	"version": "1.0.0",
	"title": "Feature card",
	"category": "cradle",
	"icon": "id-alt",
	"description": "A card with an optional image, heading, short text and a link.",
	"keywords": [ "card", "feature", "teaser" ],
	"textdomain": "cradle-blocks",
	"attributes": {
		"title": { "type": "string", "default": "" },
		"body": { "type": "string", "default": "" },
		"imageId": { "type": "integer", "default": 0 },
		"imageUrl": { "type": "string", "default": "" },
		"imageAlt": { "type": "string", "default": "" },
		"link": { "type": "string", "default": "" },
		"linkText": { "type": "string", "default": "" },
		"titleLink": { "type": "boolean", "default": false },
		"headingLevel": { "type": "integer", "default": 3 },
		"variant": { "type": "string", "enum": [ "plain", "outlined", "elevated" ], "default": "plain" },
		"mediaPosition": { "type": "string", "enum": [ "top", "start" ], "default": "top" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"color": { "background": true, "text": true, "link": true },
		"spacing": { "padding": true, "margin": [ "top", "bottom" ] },
		"typography": { "fontSize": true }
	},
	"example": {
		"attributes": {
			"title": "Feature card",
			"body": "Short supporting text for this feature.",
			"link": "#",
			"linkText": "Learn more"
		}
	},
	"editorScript": "file:./editor.js",
	"style": "file:./style.css"
}
