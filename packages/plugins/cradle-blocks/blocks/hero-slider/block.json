{
	"$schema": "https://schemas.wp.org/wp/7.1/block.json",
	"apiVersion": 3,
	"name": "cradle/hero-slider",
	"version": "3.0.0",
	"title": "Hero slider",
	"category": "cradle",
	"icon": "slides",
	"description": "An accessible hero slideshow of published entries: the latest of a content type, or the entries you choose. Style and behavior are set here.",
	"keywords": [ "hero", "slider", "slideshow", "carousel", "banner" ],
	"textdomain": "cradle-blocks",
	"attributes": {
		"postType": { "type": "string", "default": "post" },
		"taxonomy": { "type": "string", "default": "" },
		"term": { "type": "string", "default": "" },
		"postIds": { "type": "array", "items": { "type": "integer" }, "default": [] },
		"count": { "type": "integer", "default": 3 },
		"orderBy": { "type": "string", "enum": [ "date", "title", "menu_order", "modified" ], "default": "date" },
		"order": { "type": "string", "enum": [ "desc", "asc" ], "default": "desc" },
		"showExcerpt": { "type": "boolean", "default": true },
		"showButton": { "type": "boolean", "default": true },
		"buttonText": { "type": "string", "default": "" },
		"headingLevel": { "type": "integer", "default": 2 },
		"label": { "type": "string", "default": "" },
		"minHeight": { "type": "string", "default": "70vh" },
		"mobileMinHeight": { "type": "string", "default": "60svh" },
		"textPlacement": { "type": "string", "enum": [ "top", "center", "bottom" ], "default": "center" },
		"contentAlign": { "type": "string", "enum": [ "start", "center", "end" ], "default": "center" },
		"contentWidth": { "type": "string", "enum": [ "narrow", "medium", "wide" ], "default": "medium" },
		"focalX": { "type": "integer", "default": 50 },
		"focalY": { "type": "integer", "default": 50 },
		"overlayColor": { "type": "string", "default": "contrast" },
		"overlayOpacity": { "type": "integer", "default": 40 },
		"textColor": { "type": "string", "default": "base" },
		"backgroundColor": { "type": "string", "default": "contrast" },
		"controlsColor": { "type": "string", "default": "base" },
		"transition": { "type": "string", "enum": [ "none", "fade", "slide" ], "default": "fade" },
		"duration": { "type": "integer", "default": 500 },
		"autoplay": { "type": "boolean", "default": false },
		"interval": { "type": "integer", "default": 7000 },
		"pauseOnHover": { "type": "boolean", "default": true },
		"arrows": { "type": "boolean", "default": true },
		"indicators": { "type": "boolean", "default": true },
		"loop": { "type": "boolean", "default": true },
		"swipe": { "type": "boolean", "default": true },
		"align": { "type": "string", "default": "full" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": { "margin": [ "top", "bottom" ] }
	},
	"editorScript": "file:./editor.js",
	"style": "file:./style.css"
}
